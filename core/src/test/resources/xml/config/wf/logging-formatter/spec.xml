<feature-spec name="logging-formatter" xmlns="urn:jboss:galleon:feature-spec:1.0">
  <refs>
    <ref feature="logging">
      <param name="profile" maps-to="profile"/>
    </ref>
  </refs>
  <params>
    <param name="profile" feature-id="true"/>
    <param name="name" feature-id="true"/>
    <param name="pattern"/>
  </params>
</feature-spec>
