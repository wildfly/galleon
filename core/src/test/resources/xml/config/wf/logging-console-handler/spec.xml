<feature-spec name="logging-console-handler" xmlns="urn:jboss:galleon:feature-spec:1.0">
  <refs>
    <ref feature="logging">
      <param name="profile" maps-to="profile"/>
    </ref>
    <ref feature="logging-formatter">
      <param name="profile" maps-to="profile"/>
      <param name="formatters" maps-to="name"/>
    </ref>
  </refs>
  <params>
    <param name="profile" feature-id="true"/>
    <param name="name" feature-id="true" default="CONSOLE"/>
    <param name="level" default="INFO"/>
    <param name="formatters" default="COLOR_PATTERN"/>
  </params>
</feature-spec>
