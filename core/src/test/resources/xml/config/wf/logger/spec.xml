<feature-spec name="logger" xmlns="urn:jboss:galleon:feature-spec:1.0">
  <refs>
    <ref feature="logging">
      <param name="profile" maps-to="profile"/>
    </ref>
  </refs>
  <params>
    <param name="profile" feature-id="true"/>
    <param name="category" feature-id="true"/>
    <param name="level" nillable="false"/>
  </params>
</feature-spec>
